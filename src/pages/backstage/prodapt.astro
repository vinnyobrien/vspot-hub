const programmes = [
  { num: "01", title: "December pilot", tag: "FOUR WEEKS", body: "Four weekly editions of The V-Spot News. A focused way to test the editorial chemistry, sharpen the message and see what the audience responds to." },
  { num: "02", title: "A monthly B2B room", tag: "2027", body: "A proposed six-month Have I Got Ecomm News for You? partnership, bringing senior voices into lively, useful conversations about investment, services and capability." },
  { num: "03", title: "Make the data playable", tag: "IDEA TO EXPERIENCE", body: "Start with a Prodapt dataset or existing content. Find the story, then shape it into a game, an event moment or a repeatable content series." },

---
import Base from '../layouts/Base.astro';
---
<Base title="Subscribe — The V Spot Network" description="Join the network: email, YouTube, or Substack. Choose your seat.">
  <main class="page">
    <div class="wrap">
      <p class="kicker">Doors at eight · Show at half past</p>
      <h1>Take a seat</h1>
    </div>

    <!-- The stage: curtains open, ostrich takes the mic, Vinny objects -->
    <div class="stage" aria-label="Animated scene: the curtains open, an ostrich approaches the microphone, and Vinny runs on to reclaim it">
      <svg viewBox="0 0 1200 380" xmlns="http://www.w3.org/2000/svg">
        <rect width="1200" height="380" fill="#0A0A0A"/>
        <rect width="1200" height="330" fill="#131736"/>
        <rect y="330" width="1200" height="50" fill="#1c1408"/>
        <rect y="326" width="1200" height="6" fill="#D2B48C" opacity=".5"/>
        <!-- spotlight -->
        <polygon points="600,0 480,330 720,330" fill="#F5E2B8" opacity=".10"/>
        <!-- mic -->
        <g>
          <line x1="600" y1="330" x2="600" y2="212" stroke="#A0A0A0" stroke-width="5"/>
          <rect x="586" y="182" width="28" height="40" rx="13" fill="#D2B48C"/>
          <rect x="586" y="182" width="28" height="22" rx="11" fill="#0A0A0A" opacity=".35"/>
        </g>

        <!-- ostrich -->
        <g class="ostrich">
          <ellipse cx="0" cy="270" rx="42" ry="30" fill="#0A0A0A"/>
          <path d="M28,252 Q52,190 46,140" fill="none" stroke="#0A0A0A" stroke-width="11" stroke-linecap="round"/>
          <circle cx="46" cy="132" r="15" fill="#0A0A0A"/>
          <path d="M60,130 L82,136 L60,144 Z" fill="#D2B48C"/>
          <circle cx="50" cy="128" r="3.2" fill="#F5E2B8"/>
          <g class="olegs">
            <line x1="-12" y1="296" x2="-16" y2="330" stroke="#0A0A0A" stroke-width="7"/>
            <line x1="14" y1="296" x2="18" y2="330" stroke="#0A0A0A" stroke-width="7"/>
          </g>
        </g>

        <!-- vinny -->
        <g class="vinny">
          <circle cx="0" cy="196" r="17" fill="#0A0A0A"/>
          <path d="M-16,214 Q0,206 16,214 L12,282 L-12,282 Z" fill="#1A1F3C" stroke="#0A0A0A" stroke-width="3"/>
          <line x1="0" y1="222" x2="0" y2="252" stroke="#E8272A" stroke-width="5"/>
          <line x1="-8" y1="282" x2="-12" y2="330" stroke="#0A0A0A" stroke-width="8"/>
          <line x1="8" y1="282" x2="12" y2="330" stroke="#0A0A0A" stroke-width="8"/>
          <line class="armback" x1="-14" y1="228" x2="-40" y2="252" stroke="#0A0A0A" stroke-width="7" stroke-linecap="round"/>
          <g class="armpoint">
            <line x1="14" y1="228" x2="52" y2="266" stroke="#0A0A0A" stroke-width="7" stroke-linecap="round"/>
          </g>
        </g>

        <!-- curtains -->
        <g class="curtL"><rect x="-10" y="0" width="620" height="336" fill="url(#velv)"/></g>
        <g class="curtR"><rect x="590" y="0" width="620" height="336" fill="url(#velv)"/></g>
        <defs>
          <linearGradient id="velv" x1="0" y1="0" x2="1" y2="0" spreadMethod="repeat" gradientUnits="userSpaceOnUse" gradientTransform="scale(46,1)">
            <stop offset="0" stop-color="#171c38"/><stop offset=".5" stop-color="#232a52"/><stop offset="1" stop-color="#171c38"/>
          </linearGradient>
        </defs>
        <rect width="1200" height="14" fill="#0A0A0A"/>
      </svg>
      <p class="stagecaption">The Ostrich Report would like a word. The word is no.</p>
    </div>

    <div class="wrap">
      <p class="grid-label">Choose your seat</p>
      <div class="seatrow">
        <a class="seat" href="#emailform">
          <h3>The Email</h3>
          <p>Essays, episodes, and the occasional perfectly deployed GIF. Direct from the desk.</p>
          <span class="status">House seats</span>
        </a>
        <a class="seat" href="https://www.youtube.com/@thevspotnews?sub_confirmation=1">
          <h3>The YouTube</h3>
          <p>Where the neon lives: Nearly News, the shows, and everything with moving pictures.</p>
          <span class="status">Front row</span>
        </a>
        <a class="seat" href="https://vinnyobrien.substack.com/subscribe">
          <h3>The Substack</h3>
          <p>The weekly Nearly News round-up and the full archive, seen through the eyes of a madman.</p>
          <span class="status">The balcony</span>
        </a>
      </div>
      <div id="emailform" style="height:24px"></div>
    </div>
  </main>
</Base>
<style>
.stage { max-width: 1200px; margin: 26px auto 8px; padding: 0 24px; }
.stage svg { width: 100%; height: auto; display: block; border: 1px solid #2a3050; }
.stagecaption { font-family: 'Space Mono', monospace; font-size: .68rem; letter-spacing: .22em; text-transform: uppercase; color: #A0A0A0; margin-top: 10px; text-align: center; }

.curtL { animation: openL 1.9s cubic-bezier(.6,0,.3,1) .6s forwards; }
.curtR { animation: openR 1.9s cubic-bezier(.6,0,.3,1) .6s forwards; }
@keyframes openL { to { transform: translateX(-560px); } }
@keyframes openR { to { transform: translateX(560px); } }

.ostrich { transform: translateX(-80px); animation: owalk 2.8s ease-in-out 2.4s forwards, oshove .9s cubic-bezier(.5,-.3,.7,1) 6.6s forwards; }
@keyframes owalk { to { transform: translateX(548px); } }
@keyframes oshove { from { transform: translateX(548px) rotate(0); } to { transform: translateX(-140px) rotate(-14deg); } }
.olegs { animation: strut .42s ease-in-out 2.4s 7 alternate; transform-origin: 0 296px; }
@keyframes strut { from { transform: rotate(4deg);} to { transform: rotate(-4deg);} }

.vinny { transform: translateX(1290px); animation: sprint .85s cubic-bezier(.3,.6,.4,1) 6.3s forwards; }
@keyframes sprint { to { transform: translateX(640px); } }
.armpoint { transform-origin: 14px 228px; transform: rotate(-70deg); animation: pointdown .5s ease-out 7.5s forwards; }
@keyframes pointdown { to { transform: rotate(18deg); } }

.seatrow { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin-top: 16px; }
.seat { border: 1px solid #2a3050; padding: 26px 24px; text-decoration: none; display: block; background: linear-gradient(180deg, rgba(10,10,10,.5), rgba(10,10,10,.15)); transition: border-color .2s, transform .2s; animation: seatglow 1.2s ease 7.8s 2; }
.seat:hover { border-color: #D2B48C; transform: translateY(-2px); }
@keyframes seatglow { 50% { border-color: #D2B48C; box-shadow: 0 0 26px rgba(210,180,140,.25); } }
.seat h3 { font-family: 'Tilt Neon', sans-serif; font-size: 1.5rem; color: #D2B48C; text-shadow: 0 0 14px rgba(210,180,140,.4); margin-bottom: 8px; }
.seat p { color: #A0A0A0; font-size: .95rem; }

@media (prefers-reduced-motion: reduce) {
  .curtL { transform: translateX(-560px); animation: none; }
  .curtR { transform: translateX(560px); animation: none; }
  .ostrich { display: none; animation: none; }
  .vinny { transform: translateX(640px); animation: none; }
  .armpoint { transform: rotate(18deg); animation: none; }
  .olegs, .seat { animation: none; }
}
</style>

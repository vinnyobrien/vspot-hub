---
import Base from '../layouts/Base.astro';
import VinlandMap from '../components/VinlandMap.astro';
import { regions } from '../data/vinland.js';
const essayCount = regions.reduce((sum, region) => sum + region.essays.length, 0);
---
<Base title="VINLAND — The V Spot Network" description="The charted archive of Vinny O'Brien: essays on commerce, marketplaces, technology, people and power. Choose a territory or plot a course through the ideas." type="CollectionPage">
  <main class="wrap page">
    <p class="kicker">Territory of ideas · Chart room</p>
    <h1>VINLAND</h1>
    <p class="vinland-intro">A chart of ideas from Tralee. {essayCount} essays across eight territories. Pick a landfall to explore a subject, or plot a course and follow the argument across the map.</p>
    <VinlandMap regions={regions} />
    <div style="height:48px"></div>
  </main>
</Base>
<style>
  .vinland-intro { max-width:68ch; color:#c9cdd8; font-size:1.08rem; line-height:1.65; }
</style>

---
// VINLAND essay layout: the art-object template. Every migrated essay renders through this.
import Base from './Base.astro';
const { title, teaser, region, date, originalDate, slug, heroImg } = Astro.props;
const jsonLd = {
  "@context": "https://schema.org", "@type": "Article",
  "headline": title, "description": teaser,
  "url": `https://thevspotnews.com/vinland/${slug}/`,
  "datePublished": originalDate, "dateModified": date,
  "author": { "@type": "Person", "name": "Vinny O'Brien", "url": "https://thevspotnews.com/about/" },
  "publisher": { "@type": "Organization", "name": "The V Spot Network", "url": "https://thevspotnews.com" },
  "isPartOf": { "@type": "CreativeWorkSeries", "name": `VINLAND — ${region}` }
};
---
<Base title={`${title} — VINLAND | The V Spot Network`} description={teaser} type="Article">
  <article class="essay">
    <header class="wrap">
      <p class="kicker">VINLAND · {region}</p>
      <h1>{title}</h1>
      <p class="dek">{teaser}</p>
      <p class="byline">By Vinny O'Brien · Originally {originalDate} · Canonical edition {date}</p>
    </header>
    {heroImg && <div class="wrap"><img class="essayhero" src={heroImg} alt="" width="1600" height="900" /></div>}
    <div class="wrap prose">
      <slot />
    </div>
    <footer class="wrap essayfoot">
      <slot name="previously" />
      <p class="muted"><a href="/vinland/">← Back to the map</a> · Adapt this essay for your stage: <a href="/book/">speak to Murt</a></p>
    </footer>
  </article>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>
<style is:global>
.essay header { padding: 64px 0 12px; }
.essay h1 { font-family: var(--display); font-size: clamp(2.2rem, 5vw, 3.6rem); color: var(--red); text-shadow: 0 0 18px rgba(232,39,42,.5); max-width: 820px; }
.essay .dek { font-size: 1.15rem; color: var(--grey); max-width: 680px; margin-top: 14px; }
.essay .byline { font-family: var(--mono); font-size: .7rem; letter-spacing: .18em; text-transform: uppercase; color: #5a6084; margin-top: 18px; }
.essayhero { width: 100%; height: auto; border: 1px solid #2a3050; margin: 22px 0 8px; }
.prose { max-width: 720px !important; padding-top: 20px; padding-bottom: 24px; font-size: 1.08rem; line-height: 1.75; }
.prose p { margin-bottom: 22px; }
.prose h2 { font-family: var(--display); color: var(--tan); font-size: 1.6rem; margin: 40px 0 14px; text-shadow: 0 0 12px rgba(210,180,140,.3); }
.prose blockquote { background: #f6f2e7; color: #111; padding: 24px 26px; font-family: var(--marker); font-size: 1.05rem; line-height: 1.5; border-bottom: 5px solid var(--red); transform: rotate(-.6deg); margin: 34px 0; }
.prose figure { margin: 32px 0; }
.prose figure img { width: 100%; height: auto; border: 1px solid #2a3050; }
.prose figcaption { font-family: var(--mono); font-size: .66rem; letter-spacing: .18em; text-transform: uppercase; color: #5a6084; margin-top: 8px; }
.prose a { color: var(--tan); }
.previously { border: 1px solid #2a3050; border-left: 3px solid var(--red); padding: 20px 22px; margin: 8px 0 26px; }
.previously .prevtag { font-family: var(--mono); font-size: .66rem; letter-spacing: .26em; text-transform: uppercase; color: var(--tan); display: block; margin-bottom: 10px; }
.previously p { color: var(--grey); font-size: .95rem; margin: 0; }
.essayfoot { padding-bottom: 72px; }
</style>

---
/**
 * The VINLAND chart.
 *
 * Renders from the same `regions` export as the index below it, so adding an
 * essay to src/data/vinland.js puts it on the chart and in the list in one edit.
 *
 * Drawn as a hunter's chart: parchment islands on a dark sea, engraved
 * coastlines, mountain and forest glyphs, rhumb lines, a compass rose, and a
 * dashed trail running the archipelago. Geography is keyed by region name; a
 * region without a shape appears in the uncharted line rather than vanishing.
 */
const { regions = [] } = Astro.props;

const GEO = {
  'The Friction Highlands': {
    d: 'M232,132 C300,84 402,72 486,104 C556,130 588,186 556,232 C512,294 400,312 316,286 C242,264 196,180 232,132 Z',
    label: [392, 190], kind: 'peaks',
    glyphs: [[292,206],[344,196],[398,208],[452,198],[330,232],[402,238]],
  },
  'The Machine Frontier': {
    d: 'M700,96 C808,60 946,84 1006,144 C1054,192 1024,266 948,286 C856,310 742,282 700,230 C664,186 662,110 700,96 Z',
    label: [858, 182], kind: 'grid',
  },
  'The Marketplace Coast': {
    d: 'M1020,330 C1088,372 1102,470 1068,552 C1040,620 976,662 926,642 C880,624 886,552 912,486 C942,410 968,352 1020,330 Z',
    label: [990, 490], rotate: 72, kind: 'coast',
  },
  'The Human Interior': {
    d: 'M410,344 C556,312 730,332 812,382 C876,420 862,504 786,534 C676,578 498,572 414,522 C354,486 348,378 410,344 Z',
    label: [608, 432], kind: 'forest',
    glyphs: [[476,470],[536,460],[596,472],[656,458],[716,470],[508,502],[632,504]],
  },
  'The Regulatory Straits': {
    d: 'M188,340 C258,356 292,414 286,478 C280,542 234,584 184,574 C140,564 126,504 136,444 C146,386 154,332 188,340 Z',
    label: [208, 458], rotate: -82, kind: 'water',
  },
  'The Atlantic Channel': {
    d: 'M46,150 C104,236 82,376 112,486 C138,580 98,640 68,700 L44,700 Z',
    label: [92, 430], rotate: -80, kind: 'water',
  },
  'The Payment Rivers': {
    d: 'M372,588 C482,566 636,574 728,604 C792,626 786,680 716,696 C610,722 456,714 378,684 C330,664 328,596 372,588 Z',
    label: [552, 644], kind: 'rivers',
  },
  'The Deep Time Ranges': {
    d: 'M480,722 C602,692 772,700 852,732 C910,756 896,806 820,818 C706,836 552,832 482,802 C438,784 440,734 480,722 Z',
    label: [664, 768], kind: 'peaks',
    glyphs: [[556,788],[616,778],[676,790],[736,780],[796,790]],
  },
};

const charted = regions.filter(r => GEO[r.name]);
const uncharted = regions.filter(r => !GEO[r.name]);
const slug = n => n.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const trail = charted.map(r => GEO[r.name].label);
const trailD = trail.length > 1
  ? trail.map((p, i) => (i === 0 ? `M${p[0]},${p[1]}` : `L${p[0]},${p[1]}`)).join(' ')
  : '';

const essays = regions.flatMap(r => r.essays.map(e => ({ ...e, regionName: r.name })));
const ROUTE_DEFS = [
  { slug: 'prisoners-of-compute', title: 'Prisoners of Compute', line: 'Follow the four-part argument from open weights to who holds the mortgage.', slugs: ['reformation-of-compute','compute-tithe','map-beneath-cloud','who-owns-the-rails'] },
  { slug: 'across-the-atlantic', title: 'Across the Atlantic', line: 'Read the crossing through Ireland, Britain and the wider US–EU divide.', slugs: ['the-amazon-ireland-meet-cute','uk-retail-index-data-and-delusion','my-united-states-of-whatever'] },
  { slug: 'merchant-ground', title: 'The merchant on the ground', line: 'Follow the argument through marketplaces, friction and the payment rails.', slugs: ['everything-you-think-about-marketplaces','show-me-the-money','who-owns-the-rails'] },
];
const routes = ROUTE_DEFS.map(route => {
  const entries = route.slugs.map(s => essays.find(e => e.slug === s)).filter(Boolean);
  const visited = [];
  entries.forEach(e => { if (!visited.includes(e.regionName)) visited.push(e.regionName); });
  const points = visited.map(n => GEO[n]?.label).filter(Boolean);
  const path = points.length > 1 ? points.map((p,i) => i === 0 ? `M${p[0]},${p[1]}` : `L${p[0]},${p[1]}`).join(' ') : '';
  return { ...route, entries, visited, points, path };
});
const waves = [[150,690],[250,762],[820,120],[904,58],[120,240],[640,860],[60,556],[1060,700]];
const rhumbs = Array.from({ length: 16 }, (_, i) => (i * Math.PI) / 8);
---

<section class="vmap" aria-labelledby="vmap-h">
  <div class="vmap-head">
    <div>
      <p class="vp-kicker">THE VINLAND CHART ROOM</p>
      <h2 id="vmap-h">Where do you want to land?</h2>
      <p>Choose a territory on the chart to open its essays, or plot a course through connected ideas.</p>
    </div>
    <span class="chart-count">${essays.length} essays · ${regions.length} territories</span>
  </div>

  <div class="chart-tools">
    <label class="chart-search">
      <span>Find a title or idea</span>
      <input type="search" placeholder="Try “AI”, “marketplaces”, “friction”…" aria-label="Search VINLAND essays" data-vinland-search />
    </label>
    <div class="search-results" data-search-results hidden aria-live="polite">
      <p class="vp-kicker">MATCHING LANDFALLS</p>
      <div class="search-result-list">
        {essays.map(e => (
          <a href={`/vinland/${e.slug}/`} data-search-item data-search-text={`${e.title} ${e.teaser || ''} ${e.regionName}`.toLowerCase()} data-search-region={slug(e.regionName)} hidden>
            <span>{e.title}</span><small>{e.regionName.replace(/^The /, '')}</small>
          </a>
        ))}
      </div>
      <p class="search-empty" data-search-empty hidden>No landfall found for that phrase. Try a territory or a broader idea.</p>
    </div>
    <div class="course-picker" aria-label="Plot a course">
      <p class="vp-kicker">PLOT A COURSE</p>
      <div class="course-list">
        {routes.map(route => (
          <button type="button" class="course-card" data-route-trigger={route.slug} aria-pressed="false">
            <span class="course-title">{route.title}</span>
            <span class="course-meta">{route.entries.length} stops</span>
            <span class="course-desc">{route.line}</span>
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="vmap-stage">
    <figure class="vmap-frame">
      <svg viewBox="0 0 1140 880" role="group" aria-label="A chart of VINLAND, eight territories of essays" preserveAspectRatio="xMidYMid meet">
      <defs>
        <radialGradient id="sea" cx="42%" cy="38%" r="86%">
          <stop offset="0%" stop-color="#141B33" />
          <stop offset="62%" stop-color="#0D1226" />
          <stop offset="100%" stop-color="#070A17" />
        </radialGradient>
        <linearGradient id="parch" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#E3D3AE" />
          <stop offset="52%" stop-color="#CDB88C" />
          <stop offset="100%" stop-color="#B09B72" />
        </linearGradient>
        <linearGradient id="parchLit" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#F8EAC7" />
          <stop offset="55%" stop-color="#E7D2A3" />
          <stop offset="100%" stop-color="#CBB283" />
        </linearGradient>
        <pattern id="hatch" width="7" height="7" patternTransform="rotate(38)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="7" stroke="#6B5836" stroke-width="0.8" stroke-opacity="0.3" />
        </pattern>
        <filter id="rough"><feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="4" seed="11" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="6" /></filter>
        <filter id="soft"><feGaussianBlur stdDeviation="11" /></filter>
        <symbol id="peak" viewBox="0 0 24 16"><path d="M2,15 L9,3 L13,9 L16,5 L22,15" fill="none" stroke="#6B5836" stroke-width="1.5" stroke-linejoin="round" /></symbol>
        <symbol id="tree" viewBox="0 0 14 18"><path d="M7,1 L11,9 L8.6,9 L12,16 L2,16 L5.4,9 L3,9 Z" fill="none" stroke="#5E6B47" stroke-width="1.3" stroke-linejoin="round" /></symbol>
        <symbol id="wave" viewBox="0 0 30 8"><path d="M1,5 C5,1 9,9 14,5 C19,1 23,9 29,5" fill="none" stroke="#D2B48C" stroke-width="1.1" stroke-opacity="0.4" /></symbol>
      </defs>

      <rect width="1140" height="880" fill="url(#sea)" />

      <g stroke="#D2B48C" stroke-opacity="0.06" stroke-width="0.8">
        {rhumbs.map(a => <line x1="960" y1="756" x2={960 + Math.cos(a) * 1500} y2={756 + Math.sin(a) * 1500} />)}
      </g>

      <g aria-hidden="true">
        {waves.map(([x, y]) => <use href="#wave" x={x} y={y} width="30" height="8" />)}
      </g>

      {trailD && <path d={trailD} class="trail" />}

      {charted.map(r => {
        const g = GEO[r.name];
        const [lx, ly] = g.label;
        const water = g.kind === 'water';
        return (
          <g class="terr" data-region={slug(r.name)} role="button" tabindex="0"
             aria-label={`${r.name}. ${r.essays.length} essays.`} aria-pressed="false">
            <path d={g.d} class="glow" filter="url(#soft)" />
            <path d={g.d} class={water ? 'strait' : 'land'} filter="url(#rough)" />
            {!water && <path d={g.d} class="hatchfill" filter="url(#rough)" />}
            <path d={g.d} class={water ? 'coast coast-water' : 'coast'} filter="url(#rough)" />
            <path d={g.d} class="halo" />

            {(g.glyphs || []).map(([gx, gy]) => (
              <use href={g.kind === 'forest' ? '#tree' : '#peak'} x={gx} y={gy}
                   width={g.kind === 'forest' ? 13 : 22} height={g.kind === 'forest' ? 17 : 15} />
            ))}
            {g.kind === 'rivers' && (
              <g class="riverlines">
                <path d="M400,650 C470,626 560,672 640,640 C690,620 720,650 748,638" />
                <path d="M394,676 C468,656 566,694 646,668" />
              </g>
            )}

            <g transform={g.rotate ? `rotate(${g.rotate} ${lx} ${ly})` : undefined}>
              <text x={lx} y={ly} class={water ? 'lbl lbl-water' : 'lbl'} text-anchor="middle">
                {r.name.replace(/^The /, '').toUpperCase()}
              </text>
              <text x={lx} y={ly + 19} class={water ? 'cnt cnt-water' : 'cnt'} text-anchor="middle">
                {r.essays.length} {r.essays.length === 1 ? 'ESSAY' : 'ESSAYS'}
              </text>
            </g>
          </g>
        );
      })}

      <g class="routes-overlay" aria-hidden="true">
        {routes.map(route => (
          <g class="route-markers" data-route-map={route.slug} hidden>
            {route.path && <path d={route.path} class="route-trace" />}
            {route.points.map(([x,y],i) => <g class="route-stop" transform={`translate(${x} ${y})`}><circle r="11" /><text y="4" text-anchor="middle">{i + 1}</text></g>)}
          </g>
        ))}
      </g>

      <g class="home" aria-hidden="true">
        <path d="M244,486 l16,16 M260,486 l-16,16" />
        <circle cx="252" cy="494" r="17" class="ring" />
        <text x="252" y="530" text-anchor="middle">TRALEE</text>
      </g>

      <g class="rose" aria-hidden="true" transform="translate(960 756)">
        <circle r="46" class="ring" /><circle r="31" class="ring" />
        <path d="M0,-52 L11,-11 L0,0 L-11,-11 Z" class="nfill" />
        <path d="M0,52 L11,11 L0,0 L-11,11 Z" class="sfill" />
        <path d="M-52,0 L-11,-11 L0,0 L-11,11 Z" class="sfill" />
        <path d="M52,0 L11,-11 L0,0 L11,11 Z" class="sfill" />
        <text y="-58" text-anchor="middle">N</text>
      </g>

      <g class="cartouche" aria-hidden="true" transform="translate(158 98)">
        <rect x="-104" y="-36" width="208" height="70" rx="2" />
        <rect x="-97" y="-29" width="194" height="56" rx="1" class="inner" />
        <text y="-2" text-anchor="middle" class="ct">VINLAND</text>
        <text y="18" text-anchor="middle" class="cs">CHARTED FROM TRALEE</text>
      </g>
    </svg>
      <figcaption>CHARTED FROM TRALEE · SELECT A LANDMASS TO MAKE LANDFALL</figcaption>
    </figure>

    <aside class="vmap-panel" aria-live="polite" aria-label="Selected essays">
      <div class="vpanel vpanel-idle" data-panel="idle">
        <p class="vp-kicker">CHART TABLE · READY</p>
        <h3>Pick a landfall</h3>
        <p class="vp-line">Each territory is a way into the archive. Select one on the map, or choose a plotted course above.</p>
        <div class="legend-note"><span class="legend-mark">01</span><span>The red marker is home: Tralee. The dotted trail is a route through the chart.</span></div>
      </div>

      {charted.map(r => (
        <div class="vpanel" data-panel={slug(r.name)} hidden>
          <p class="vp-kicker">{r.essays.length} {r.essays.length === 1 ? 'LANDfall' : 'LANDFALLS'}</p>
          <h3>{r.name}</h3>
          <p class="vp-line">{r.line}</p>
          <div class="vp-list">
            {r.essays.map(e => (
              <a href={`/vinland/${e.slug}/`}>
                <span class="vp-title">{e.title}</span>
                <span class="vp-status">{e.status}</span>
                {e.teaser && <span class="vp-teaser">{e.teaser}</span>}
              </a>
            ))}
          </div>
        </div>
      ))}

      {routes.map(route => (
        <div class="vpanel route-panel" data-course-panel={route.slug} hidden>
          <p class="vp-kicker">PLOTTED COURSE · {route.entries.length} STOPS</p>
          <h3>{route.title}</h3>
          <p class="vp-line">{route.line}</p>
          <ol class="route-steps">
            {route.entries.map((e,i) => (
              <li>
                <span class="stop-num">{String(i + 1).padStart(2,'0')}</span>
                <a href={`/vinland/${e.slug}/`}>
                  <span class="vp-title">{e.title}</span>
                  <span class="route-region" data-route-region={slug(e.regionName)}>{e.regionName.replace(/^The /, '')}</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      ))}
    </aside>
  </div>
</section>

<style>
  .vmap { margin: 30px 0 46px; }
  .vmap-head { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:18px; }
  .vmap-head h2 { font-size:clamp(1.55rem,3vw,2rem); margin:0 0 4px; }
  .vmap-head p:not(.vp-kicker) { color:#a0a0a0; font-size:.98rem; margin:0; max-width:64ch; }
  .chart-count,.vp-kicker { font-family:var(--mono); text-transform:uppercase; letter-spacing:.18em; color:#D2B48C; font-size:.66rem; }
  .chart-count { white-space:nowrap; padding:8px 10px; border:1px solid rgba(210,180,140,.28); }
  .chart-tools { position:relative; display:grid; grid-template-columns:minmax(230px,.72fr) minmax(0,1.6fr); gap:16px; margin-bottom:16px; }
  .chart-search { display:block; padding:14px 16px; background:#10132A; border:1px solid rgba(210,180,140,.2); }
  .chart-search span { display:block; font-family:var(--mono); text-transform:uppercase; letter-spacing:.18em; font-size:.65rem; color:#D2B48C; margin-bottom:8px; }
  .chart-search input { width:100%; border:1px solid #353a55; background:#090d1d; color:#F3F1EC; padding:11px 12px; font:inherit; font-size:.92rem; outline:none; }
  .chart-search input:focus { border-color:#E8272A; box-shadow:0 0 0 2px rgba(232,39,42,.2); }
  .course-picker { background:#10132A; border:1px solid rgba(210,180,140,.2); padding:12px 14px; min-width:0; }
  .course-picker > .vp-kicker { margin:0 0 9px; }
  .course-list { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
  .course-card { appearance:none; text-align:left; display:flex; flex-direction:column; align-items:flex-start; gap:4px; padding:10px 11px; background:#161B36; border:1px solid #2a3050; border-top:2px solid #D2B48C; color:#F3F1EC; cursor:pointer; font:inherit; min-height:92px; }
  .course-card:hover,.course-card:focus-visible,.course-card[aria-pressed="true"] { border-top-color:#E8272A; background:#1d2342; outline:none; }
  .course-title { font-family:var(--display); color:#D2B48C; font-size:.99rem; line-height:1.15; }
  .course-meta { font-family:var(--mono); color:#E8272A; font-size:.59rem; letter-spacing:.16em; text-transform:uppercase; }
  .course-desc { color:#a0a0a0; font-size:.74rem; line-height:1.35; }
  .search-results { position:absolute; z-index:10; top:74px; left:0; width:min(420px,100%); max-height:430px; overflow:auto; background:#10132A; border:1px solid #D2B48C; box-shadow:0 18px 50px rgba(0,0,0,.55); padding:14px; }
  .search-results[hidden] { display:none; }
  .search-results > .vp-kicker { margin:0 0 8px; }
  .search-result-list { display:grid; gap:5px; }
  .search-result-list a { display:flex; justify-content:space-between; gap:12px; padding:9px 10px; color:#F3F1EC; background:#161B36; text-decoration:none; font-size:.85rem; }
  .search-result-list a:hover,.search-result-list a:focus-visible { background:#252c4d; outline:1px solid #E8272A; }
  .search-result-list small { color:#D2B48C; font-family:var(--mono); font-size:.59rem; text-transform:uppercase; white-space:nowrap; }
  .search-empty { color:#a0a0a0; font-size:.82rem; margin:10px 0 2px; }
  .vmap-stage { display:grid; grid-template-columns:minmax(0,1.65fr) minmax(310px,.85fr); align-items:stretch; }
  .vmap-frame { position:relative; min-width:0; margin:0; padding:9px; background:#070A17; border:1px solid rgba(210,180,140,.22); box-shadow:inset 0 0 90px rgba(0,0,0,.85); }
  .vmap-frame svg { display:block; width:100%; height:auto; }
  .vmap-frame figcaption { padding:8px 4px 2px; font: .58rem var(--mono); letter-spacing:.18em; color:#8a8f9c; }
  .land { fill:url(#parch); } .hatchfill { fill:url(#hatch); } .strait { fill:#101736; }
  .coast { fill:none; stroke:#4A3C22; stroke-width:2.2; stroke-opacity:.8; }
  .coast-water { stroke:#D2B48C; stroke-opacity:.45; stroke-dasharray:6 5; stroke-width:1.4; }
  .glow { fill:#E8272A; opacity:0; } .halo { fill:none; stroke:#E8272A; stroke-width:2.6; opacity:0; }
  .lbl { font-size:17px; font-weight:800; letter-spacing:.1em; fill:#3B2E16; pointer-events:none; }
  .lbl-water { fill:#D2B48C; font-size:14px; letter-spacing:.22em; }
  .cnt { font-size:9.5px; letter-spacing:.2em; fill:#6B5836; pointer-events:none; } .cnt-water { fill:#8a8f9c; }
  .riverlines path { fill:none; stroke:#4C6B7A; stroke-width:1.6; stroke-opacity:.7; }
  .trail { fill:none; stroke:#E8272A; stroke-width:1.5; stroke-opacity:.26; stroke-dasharray:2 9; stroke-linecap:round; }
  .terr { cursor:pointer; }
  .terr .land,.terr .glow,.terr .halo { transition:fill .2s ease,opacity .2s ease; }
  .terr:hover .land,.terr:focus-visible .land { fill:url(#parchLit); }
  .terr:hover .glow,.terr:focus-visible .glow { opacity:.16; }
  .terr:hover .halo,.terr:focus-visible .halo { opacity:.75; }
  .terr:focus { outline:none; }
  .terr[data-active="true"] .land,.terr[data-route-active="true"] .land { fill:url(#parchLit); }
  .terr[data-active="true"] .halo { opacity:1; } .terr[data-route-active="true"] .halo { opacity:.72; }
  .terr[data-active="true"] .glow,.terr[data-route-active="true"] .glow { opacity:.2; }
  .route-trace { fill:none; stroke:#E8272A; stroke-width:3; stroke-opacity:.85; stroke-dasharray:5 8; stroke-linecap:round; filter:drop-shadow(0 0 4px rgba(232,39,42,.8)); }
  .route-stop circle { fill:#E8272A; stroke:#F3F1EC; stroke-width:1.5; } .route-stop text { fill:#fff; font:700 9px var(--mono); }
  .home path { stroke:#E8272A; stroke-width:3; stroke-linecap:round; fill:none; } .home .ring { fill:none; stroke:#E8272A; stroke-opacity:.4; stroke-width:1; }
  .home text { font-size:10px; fill:#E8272A; letter-spacing:.26em; }
  .rose .ring { fill:none; stroke:#D2B48C; stroke-opacity:.3; stroke-width:1; } .rose .nfill { fill:#E8272A; fill-opacity:.8; } .rose .sfill { fill:#D2B48C; fill-opacity:.35; }
  .rose text { font-size:12px; fill:#D2B48C; letter-spacing:.1em; }
  .cartouche rect { fill:#C9B48A; stroke:#4A3C22; stroke-width:1.6; } .cartouche .inner { fill:none; stroke:#4A3C22; stroke-opacity:.5; stroke-width:.8; }
  .cartouche .ct { font-size:27px; font-weight:800; letter-spacing:.16em; fill:#3B2E16; } .cartouche .cs { font-size:8px; letter-spacing:.24em; fill:#6B5836; }
  .vmap-panel { min-width:0; max-height:740px; overflow:auto; padding:22px; background:#10132A; border:1px solid rgba(210,180,140,.2); border-left:0; }
  .vpanel[hidden] { display:none; } .vpanel .vp-kicker { margin:0 0 8px; }
  .vpanel h3 { font:clamp(1.25rem,2vw,1.75rem)/1.1 var(--display); color:#D2B48C; margin:0 0 8px; }
  .vp-line { color:#a0a0a0; font-size:.91rem; line-height:1.5; margin:0 0 16px; }
  .legend-note { display:flex; gap:10px; align-items:flex-start; padding:12px; background:#161B36; color:#a0a0a0; font-size:.82rem; line-height:1.45; }
  .legend-mark { color:#E8272A; font: .72rem var(--mono); border:1px solid rgba(232,39,42,.65); padding:3px 5px; }
  .vp-list { display:grid; gap:9px; }
  .vp-list a { display:block; padding:11px 12px; background:#161B36; border-left:2px solid #D2B48C; text-decoration:none; transition:background .15s ease,border-color .15s ease; }
  .vp-list a:hover { background:#1d2342; border-left-color:#E8272A; }
  .vp-title { display:block; font-weight:600; font-size:.94rem; line-height:1.25; color:#F3F1EC; }
  .vp-status { display:block; font: .58rem var(--mono); letter-spacing:.12em; text-transform:uppercase; color:#D2B48C; margin-top:5px; }
  .vp-teaser { display:block; font-size:.77rem; color:#a0a0a0; line-height:1.4; margin-top:5px; }
  .route-steps { list-style:none; margin:16px 0 0; padding:0; counter-reset:route; }
  .route-steps li { display:grid; grid-template-columns:30px 1fr; gap:8px; padding:11px 0; border-top:1px solid rgba(210,180,140,.17); }
  .stop-num { color:#E8272A; font: .72rem var(--mono); padding-top:2px; }
  .route-steps a { text-decoration:none; } .route-steps a:hover .vp-title { color:#D2B48C; }
  .route-region { display:block; margin-top:4px; color:#8a8f9c; font: .58rem var(--mono); letter-spacing:.14em; text-transform:uppercase; }
  .vmap-uncharted { font-size:.82rem; color:#8a8f9c; margin-top:10px; }
  @media(max-width:900px) { .chart-tools { grid-template-columns:1fr; } .course-list { grid-template-columns:repeat(3,minmax(0,1fr)); } .vmap-stage { grid-template-columns:1fr; } .vmap-frame { border-bottom:0; } .vmap-panel { max-height:none; border-left:1px solid rgba(210,180,140,.2); border-top:0; } }
  @media(max-width:580px) { .vmap-head { align-items:flex-start; flex-direction:column; gap:8px; } .course-list { grid-template-columns:1fr; } .course-card { min-height:0; } .search-results { top:75px; width:100%; } .vmap-panel { padding:16px; } }
  @media(prefers-reduced-motion:reduce) { .terr .land,.terr .glow,.terr .halo,.vp-list a,.course-card { transition:none; } }
</style>

<script is:inline>
  (function () {
    const root = document.currentScript.closest('section.vmap');
    if (!root) return;
    const terrs = [...root.querySelectorAll('.terr')];
    const regionPanels = [...root.querySelectorAll('[data-panel]')];
    const routePanels = [...root.querySelectorAll('[data-course-panel]')];
    const routeButtons = [...root.querySelectorAll('[data-route-trigger]')];
    const routeMaps = [...root.querySelectorAll('[data-route-map]')];
    const search = root.querySelector('[data-vinland-search]');
    const results = root.querySelector('[data-search-results]');
    const searchItems = [...root.querySelectorAll('[data-search-item]')];
    const empty = root.querySelector('[data-search-empty]');
    function clearRoute() {
      routePanels.forEach(p => p.hidden = true);
      routeMaps.forEach(p => p.hidden = true);
      routeButtons.forEach(b => b.setAttribute('aria-pressed','false'));
      terrs.forEach(t => delete t.dataset.routeActive);
    }
    function showRegion(id) {
      clearRoute();
      regionPanels.forEach(p => p.hidden = p.dataset.panel !== id);
      terrs.forEach(t => { const active = t.dataset.region === id; t.dataset.active = String(active); t.setAttribute('aria-pressed',String(active)); });
    }
    terrs.forEach(t => {
      const activate = () => showRegion(t.dataset.region);
      t.addEventListener('click', activate);
      t.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(); } });
    });
    routeButtons.forEach(b => b.addEventListener('click', () => {
      const id = b.dataset.routeTrigger;
      regionPanels.forEach(p => p.hidden = true);
      routePanels.forEach(p => p.hidden = p.dataset.coursePanel !== id);
      clearRoute();
      const routeButton = routeButtons.find(x => x.dataset.routeTrigger === id);
      if (routeButton) routeButton.setAttribute('aria-pressed','true');
      const map = routeMaps.find(x => x.dataset.routeMap === id);
      if (map) map.hidden = false;
      const route = root.querySelector(`[data-course-panel="${id}"]`);
      const regions = route ? [...new Set([...route.querySelectorAll('.route-region')].map(x => x.dataset.routeRegion))] : [];
      terrs.forEach(t => t.dataset.routeActive = String(regions.includes(t.dataset.region)));
      const active = root.querySelector('.vmap-panel');
      if (active && window.matchMedia('(max-width: 900px)').matches) active.scrollIntoView({behavior:'smooth',block:'start'});
    }));
    if (search && results) {
      search.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        if (!q) {
          results.hidden = true;
          searchItems.forEach(item => item.hidden = true);
          empty.hidden = true;
          return;
        }
        let count = 0;
        searchItems.forEach(item => {
          const match = item.dataset.searchText.includes(q);
          item.hidden = !match;
          if (match) count++;
        });
        results.hidden = false;
        empty.hidden = count > 0;
        if (count) showRegion(searchItems.find(item => !item.hidden).dataset.searchRegion);
      });
      search.addEventListener('keydown', e => { if (e.key === 'Escape') { search.value=''; search.dispatchEvent(new Event('input')); } });
    }
  })();
</script>

---
/**
 * The VINLAND chart.
 *
 * Renders from the same `regions` export as the index below it, so adding an
 * essay to src/data/vinland.js puts it on the chart and in the list in one edit.
 *
 * Drawn as a hunter's chart: parchment islands on a dark sea, engraved
 * coastlines, mountain and forest glyphs, rhumb lines, a compass rose, and a
 * dashed trail running the archipelago. Geography is keyed by region name; a
 * region without a shape appears in the uncharted line rather than vanishing.
 */
const { regions = [] } = Astro.props;

const GEO = {
  'The Friction Highlands': {
    d: 'M232,132 C300,84 402,72 486,104 C556,130 588,186 556,232 C512,294 400,312 316,286 C242,264 196,180 232,132 Z',
    label: [392, 190], kind: 'peaks',
    glyphs: [[292,206],[344,196],[398,208],[452,198],[330,232],[402,238]],
  },
  'The Machine Frontier': {
    d: 'M700,96 C808,60 946,84 1006,144 C1054,192 1024,266 948,286 C856,310 742,282 700,230 C664,186 662,110 700,96 Z',
    label: [858, 182], kind: 'grid',
  },
  'The Marketplace Coast': {
    d: 'M1020,330 C1088,372 1102,470 1068,552 C1040,620 976,662 926,642 C880,624 886,552 912,486 C942,410 968,352 1020,330 Z',
    label: [990, 490], rotate: 72, kind: 'coast',
  },
  'The Human Interior': {
    d: 'M410,344 C556,312 730,332 812,382 C876,420 862,504 786,534 C676,578 498,572 414,522 C354,486 348,378 410,344 Z',
    label: [608, 432], kind: 'forest',
    glyphs: [[476,470],[536,460],[596,472],[656,458],[716,470],[508,502],[632,504]],
  },
  'The Regulatory Straits': {
    d: 'M188,340 C258,356 292,414 286,478 C280,542 234,584 184,574 C140,564 126,504 136,444 C146,386 154,332 188,340 Z',
    label: [208, 458], rotate: -82, kind: 'water',
  },
  'The Atlantic Channel': {
    d: 'M46,150 C104,236 82,376 112,486 C138,580 98,640 68,700 L44,700 Z',
    label: [92, 430], rotate: -80, kind: 'water',
  },
  'The Payment Rivers': {
    d: 'M372,588 C482,566 636,574 728,604 C792,626 786,680 716,696 C610,722 456,714 378,684 C330,664 328,596 372,588 Z',
    label: [552, 644], kind: 'rivers',
  },
  'The Deep Time Ranges': {
    d: 'M480,722 C602,692 772,700 852,732 C910,756 896,806 820,818 C706,836 552,832 482,802 C438,784 440,734 480,722 Z',
    label: [664, 768], kind: 'peaks',
    glyphs: [[556,788],[616,778],[676,790],[736,780],[796,790]],
  },
};

const charted = regions.filter(r => GEO[r.name]);
const uncharted = regions.filter(r => !GEO[r.name]);
const slug = n => n.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const trail = charted.map(r => GEO[r.name].label);
const trailD = trail.length > 1
  ? trail.map((p, i) => (i === 0 ? `M${p[0]},${p[1]}` : `L${p[0]},${p[1]}`)).join(' ')
  : '';

const waves = [[150,690],[250,762],[820,120],[904,58],[120,240],[640,860],[60,556],[1060,700]];
const rhumbs = Array.from({ length: 16 }, (_, i) => (i * Math.PI) / 8);
---

<section class="vmap" aria-labelledby="vmap-h">
  <div class="vmap-head">
    <h2 id="vmap-h">The chart</h2>
    <p>Eight territories. Hover, tap or tab a landmass. The full written index follows beneath.</p>
  </div>

  <figure class="vmap-frame">
    <svg viewBox="0 0 1140 880" role="group" aria-label="A chart of VINLAND, eight territories of essays" preserveAspectRatio="xMidYMid meet">
      <defs>
        <radialGradient id="sea" cx="42%" cy="38%" r="86%">
          <stop offset="0%" stop-color="#141B33" />
          <stop offset="62%" stop-color="#0D1226" />
          <stop offset="100%" stop-color="#070A17" />
        </radialGradient>
        <linearGradient id="parch" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#E3D3AE" />
          <stop offset="52%" stop-color="#CDB88C" />
          <stop offset="100%" stop-color="#B09B72" />
        </linearGradient>
        <linearGradient id="parchLit" x1="0" y1="0" x2="0.4" y2="1">
          <stop offset="0%" stop-color="#F8EAC7" />
          <stop offset="55%" stop-color="#E7D2A3" />
          <stop offset="100%" stop-color="#CBB283" />
        </linearGradient>
        <pattern id="hatch" width="7" height="7" patternTransform="rotate(38)" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0" x2="0" y2="7" stroke="#6B5836" stroke-width="0.8" stroke-opacity="0.3" />
        </pattern>
        <filter id="rough"><feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="4" seed="11" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="6" /></filter>
        <filter id="soft"><feGaussianBlur stdDeviation="11" /></filter>
        <symbol id="peak" viewBox="0 0 24 16"><path d="M2,15 L9,3 L13,9 L16,5 L22,15" fill="none" stroke="#6B5836" stroke-width="1.5" stroke-linejoin="round" /></symbol>
        <symbol id="tree" viewBox="0 0 14 18"><path d="M7,1 L11,9 L8.6,9 L12,16 L2,16 L5.4,9 L3,9 Z" fill="none" stroke="#5E6B47" stroke-width="1.3" stroke-linejoin="round" /></symbol>
        <symbol id="wave" viewBox="0 0 30 8"><path d="M1,5 C5,1 9,9 14,5 C19,1 23,9 29,5" fill="none" stroke="#D2B48C" stroke-width="1.1" stroke-opacity="0.4" /></symbol>
      </defs>

      <rect width="1140" height="880" fill="url(#sea)" />

      <g stroke="#D2B48C" stroke-opacity="0.06" stroke-width="0.8">
        {rhumbs.map(a => <line x1="960" y1="756" x2={960 + Math.cos(a) * 1500} y2={756 + Math.sin(a) * 1500} />)}
      </g>

      <g aria-hidden="true">
        {waves.map(([x, y]) => <use href="#wave" x={x} y={y} width="30" height="8" />)}
      </g>

      {trailD && <path d={trailD} class="trail" />}

      {charted.map(r => {
        const g = GEO[r.name];
        const [lx, ly] = g.label;
        const water = g.kind === 'water';
        return (
          <g class="terr" data-region={slug(r.name)} role="button" tabindex="0"
             aria-label={`${r.name}. ${r.essays.length} essays.`}>
            <path d={g.d} class="glow" filter="url(#soft)" />
            <path d={g.d} class={water ? 'strait' : 'land'} filter="url(#rough)" />
            {!water && <path d={g.d} class="hatchfill" filter="url(#rough)" />}
            <path d={g.d} class={water ? 'coast coast-water' : 'coast'} filter="url(#rough)" />
            <path d={g.d} class="halo" />

            {(g.glyphs || []).map(([gx, gy]) => (
              <use href={g.kind === 'forest' ? '#tree' : '#peak'} x={gx} y={gy}
                   width={g.kind === 'forest' ? 13 : 22} height={g.kind === 'forest' ? 17 : 15} />
            ))}
            {g.kind === 'rivers' && (
              <g class="riverlines">
                <path d="M400,650 C470,626 560,672 640,640 C690,620 720,650 748,638" />
                <path d="M394,676 C468,656 566,694 646,668" />
              </g>
            )}

            <g transform={g.rotate ? `rotate(${g.rotate} ${lx} ${ly})` : undefined}>
              <text x={lx} y={ly} class={water ? 'lbl lbl-water' : 'lbl'} text-anchor="middle">
                {r.name.replace(/^The /, '').toUpperCase()}
              </text>
              <text x={lx} y={ly + 19} class={water ? 'cnt cnt-water' : 'cnt'} text-anchor="middle">
                {r.essays.length} {r.essays.length === 1 ? 'ESSAY' : 'ESSAYS'}
              </text>
            </g>
          </g>
        );
      })}

      <g class="home" aria-hidden="true">
        <path d="M244,486 l16,16 M260,486 l-16,16" />
        <circle cx="252" cy="494" r="17" class="ring" />
        <text x="252" y="530" text-anchor="middle">TRALEE</text>
      </g>

      <g class="rose" aria-hidden="true" transform="translate(960 756)">
        <circle r="46" class="ring" /><circle r="31" class="ring" />
        <path d="M0,-52 L11,-11 L0,0 L-11,-11 Z" class="nfill" />
        <path d="M0,52 L11,11 L0,0 L-11,11 Z" class="sfill" />
        <path d="M-52,0 L-11,-11 L0,0 L-11,11 Z" class="sfill" />
        <path d="M52,0 L11,-11 L0,0 L11,11 Z" class="sfill" />
        <text y="-58" text-anchor="middle">N</text>
      </g>

      <g class="cartouche" aria-hidden="true" transform="translate(158 98)">
        <rect x="-104" y="-36" width="208" height="70" rx="2" />
        <rect x="-97" y="-29" width="194" height="56" rx="1" class="inner" />
        <text y="-2" text-anchor="middle" class="ct">VINLAND</text>
        <text y="18" text-anchor="middle" class="cs">CHARTED FROM TRALEE</text>
      </g>
    </svg>
  </figure>

  <div class="vmap-panel" aria-live="polite">
    <div class="vpanel vpanel-idle" data-panel="idle">
      <p class="vp-kicker">Uncharted</p>
      <h3>Choose a territory</h3>
      <p class="vp-line">The essays are grouped by what they argue about, not when they were written.</p>
    </div>

    {charted.map(r => (
      <div class="vpanel" data-panel={slug(r.name)} hidden>
        <p class="vp-kicker">{r.essays.length} {r.essays.length === 1 ? 'essay' : 'essays'}</p>
        <h3>{r.name}</h3>
        <p class="vp-line">{r.line}</p>
        <div class="vp-list">
          {r.essays.map(e => (
            <a href={`/vinland/${e.slug}/`}>
              <span class="vp-title">{e.title}</span>
              <span class="vp-status">{e.status}</span>
              {e.teaser && <span class="vp-teaser">{e.teaser}</span>}
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  {uncharted.length > 0 && (
    <p class="vmap-uncharted">Uncharted: {uncharted.map(r => r.name).join(', ')}. Add a shape in VinlandMap.astro to bring these onto the chart.</p>
  )}
</section>

<style>
  .vmap { margin: 30px 0 46px; }
  .vmap-head h2 { font-size: 1.7rem; margin: 0 0 2px; }
  .vmap-head p { color: #8a8f9c; font-size: .92rem; margin: 0 0 16px; }

  .vmap-frame {
    margin: 0; padding: 10px;
    background: #070A17;
    border: 1px solid rgba(210,180,140,.22);
    box-shadow: inset 0 0 90px rgba(0,0,0,.85);
  }
  .vmap-frame svg { display: block; width: 100%; height: auto; }

  .land { fill: url(#parch); }
  .hatchfill { fill: url(#hatch); }
  .strait { fill: #101736; }
  .coast { fill: none; stroke: #4A3C22; stroke-width: 2.2; stroke-opacity: .8; }
  .coast-water { stroke: #D2B48C; stroke-opacity: .45; stroke-dasharray: 6 5; stroke-width: 1.4; }
  .glow { fill: #E8272A; opacity: 0; }
  .halo { fill: none; stroke: #E8272A; stroke-width: 2.6; opacity: 0; }

  .lbl { font-size: 17px; font-weight: 800; letter-spacing: .1em; fill: #3B2E16; pointer-events: none; }
  .lbl-water { fill: #D2B48C; font-size: 14px; letter-spacing: .22em; }
  .cnt { font-size: 9.5px; letter-spacing: .2em; fill: #6B5836; pointer-events: none; }
  .cnt-water { fill: #8a8f9c; }

  .riverlines path { fill: none; stroke: #4C6B7A; stroke-width: 1.6; stroke-opacity: .7; }
  .trail { fill: none; stroke: #E8272A; stroke-width: 1.5; stroke-opacity: .26; stroke-dasharray: 2 9; stroke-linecap: round; }

  .terr { cursor: pointer; }
  .terr .land, .terr .glow, .terr .halo { transition: fill .2s ease, opacity .2s ease; }
  .terr:hover .land, .terr:focus-visible .land { fill: url(#parchLit); }
  .terr:hover .glow, .terr:focus-visible .glow { opacity: .16; }
  .terr:hover .halo, .terr:focus-visible .halo { opacity: .75; }
  .terr:focus { outline: none; }
  .terr[data-active="true"] .land { fill: url(#parchLit); }
  .terr[data-active="true"] .halo { opacity: 1; }
  .terr[data-active="true"] .glow { opacity: .22; }

  .home path { stroke: #E8272A; stroke-width: 3; stroke-linecap: round; fill: none; }
  .home .ring { fill: none; stroke: #E8272A; stroke-opacity: .4; stroke-width: 1; }
  .home text { font-size: 10px; fill: #E8272A; letter-spacing: .26em; }

  .rose .ring { fill: none; stroke: #D2B48C; stroke-opacity: .3; stroke-width: 1; }
  .rose .nfill { fill: #E8272A; fill-opacity: .8; }
  .rose .sfill { fill: #D2B48C; fill-opacity: .35; }
  .rose text { font-size: 12px; fill: #D2B48C; letter-spacing: .1em; }

  .cartouche rect { fill: #C9B48A; stroke: #4A3C22; stroke-width: 1.6; }
  .cartouche .inner { fill: none; stroke: #4A3C22; stroke-opacity: .5; stroke-width: .8; }
  .cartouche .ct { font-size: 27px; font-weight: 800; letter-spacing: .16em; fill: #3B2E16; }
  .cartouche .cs { font-size: 8px; letter-spacing: .24em; fill: #6B5836; }

  .vmap-panel { border: 1px solid rgba(210,180,140,.2); border-top: none; background: #10132A; padding: 20px; min-height: 190px; }
  .vp-kicker { font-size: .66rem; letter-spacing: .22em; text-transform: uppercase; color: #D2B48C; margin: 0 0 5px; }
  .vpanel h3 { margin: 0 0 5px; font-size: 1.45rem; line-height: 1.1; }
  .vp-line { color: #8a8f9c; font-size: .92rem; line-height: 1.5; margin: 0 0 15px; max-width: 62ch; }
  .vp-list { display: grid; gap: 10px; grid-template-columns: 1fr; }
  @media (min-width: 720px) { .vp-list { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); } }
  .vp-list a { display: block; padding: 12px 14px; background: #161B36; border-left: 2px solid #D2B48C; text-decoration: none; transition: background .15s ease, border-color .15s ease; }
  .vp-list a:hover { background: #1D2342; border-left-color: #E8272A; }
  .vp-title { display: block; font-weight: 600; font-size: 1rem; line-height: 1.25; }
  .vp-status { display: block; font-size: .66rem; letter-spacing: .14em; text-transform: uppercase; color: #D2B48C; margin-top: 4px; }
  .vp-teaser { display: block; font-size: .85rem; color: #8a8f9c; line-height: 1.45; margin-top: 6px; }

  .vmap-uncharted { font-size: .82rem; color: #8a8f9c; margin-top: 10px; }

  @media (prefers-reduced-motion: reduce) { .terr .land, .terr .glow, .terr .halo, .vp-list a { transition: none; } }
</style>

<script is:inline>
  (function () {
    const root = document.currentScript.closest('section');
    if (!root) return;
    const terrs = root.querySelectorAll('.terr');
    const panels = root.querySelectorAll('.vpanel');
    function show(id) {
      panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
      terrs.forEach(t => { t.dataset.active = String(t.dataset.region === id); });
    }
    terrs.forEach(t => {
      const go = () => show(t.dataset.region);
      t.addEventListener('click', go);
      t.addEventListener('mouseenter', go);
      t.addEventListener('focus', go);
      t.addEventListener('keydown', e => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
      });
    });
    const svg = root.querySelector('svg');
    if (svg) svg.addEventListener('mouseleave', () => show('idle'));
  })();
</script>
